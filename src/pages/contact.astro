---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Pic from '../components/Pic.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { site } from '../data/site';
import { tel } from '../lib/paths';
const embed = `https://www.google.com/maps?q=${encodeURIComponent(site.mapsQuery)}&output=embed`;
---
<Base
  title="Contact Byrne Auto & Performance | Las Vegas, NV 89115"
  description="Call (702) 742-0873 or visit 4354 E Alexander Rd, Las Vegas, NV 89115. Open Mon–Fri 8am–5pm. Click to call."
  path="/contact"
  trail={[{ name: 'Contact', path: '/contact' }]}
>
  <section class="pb-12 pt-32 sm:pt-40">
    <div class="wrap">
      <Breadcrumbs trail={[{ name: 'Contact' }]} />
      <h1 class="mt-6" data-reveal>Contact the shop</h1>
      <p class="lead mt-5" data-reveal style="--d:80ms">Call with your vehicle's year, make and model and what you need. We're open Monday through Friday, 8am to 5pm.</p>
    </div>
  </section>
  <section class="pb-24">
    <div class="wrap grid gap-10 lg:grid-cols-[1fr_1.3fr]">
      <div class="grid content-start gap-4" data-reveal>
        <a href={tel} class="btn btn-red w-full !text-2xl" data-call><Icon name="phone" size={24} /> Call {site.phone.display}</a>
        <address class="mt-4 space-y-6 not-italic">
          <div class="flex gap-4"><Icon name="map-pin" size={24} class="mt-1 shrink-0 text-red-hot" /><div><p class="eyebrow !before:hidden">Address</p><p class="mt-1 text-lg">{site.address.street}<br />{site.address.city}, {site.address.region} {site.address.zip}</p><a class="mt-1 inline-block text-red-hot hover:text-white" href={`https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(site.mapsQuery)}`}>Get directions →</a></div></div>
          <div class="flex gap-4"><Icon name="clock" size={24} class="mt-1 shrink-0 text-red-hot" /><div><p class="eyebrow">Hours</p><table class="mt-1 text-lg"><tbody><tr><td class="pr-6">Monday – Friday</td><td>8am – 5pm</td></tr><tr class="text-fog"><td class="pr-6">Saturday</td><td>Closed</td></tr><tr class="text-fog"><td class="pr-6">Sunday</td><td>Closed</td></tr></tbody></table></div></div>
          <div class="flex gap-4"><Icon name="mail" size={24} class="mt-1 shrink-0 text-red-hot" /><div><p class="eyebrow">Email</p><a class="mt-1 block break-all text-lg hover:text-red-hot" href={`mailto:${site.email}`}>{site.email}</a></div></div>
        </address>
      </div>
      <div class="relative isolate min-h-[22rem] overflow-hidden rounded-md border border-line bg-coal lg:min-h-[34rem]" data-reveal style="--d:100ms" id="map-box" data-src={embed}>
        <Pic name="storefront-sign" alt="Byrne Auto & Performance building at 4354 E Alexander Rd, Las Vegas, NV 89115" sizes="(min-width:1024px) 700px, 92vw" widths={[500, 680]} class="absolute inset-0 -z-10 opacity-40" />
        <div class="grid h-full min-h-[22rem] place-content-center gap-4 p-8 text-center lg:min-h-[34rem]">
          <Icon name="map-pin" size={40} class="mx-auto text-red-hot" />
          <p class="font-display text-3xl font-extrabold uppercase">{site.address.street}<br />{site.address.city}, {site.address.region} {site.address.zip}</p>
          <button type="button" id="map-load" class="btn btn-red mx-auto">Load interactive map</button>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  document.getElementById('map-load')?.addEventListener('click', () => {
    const box = document.getElementById('map-box')!;
    const f = document.createElement('iframe');
    f.src = box.dataset.src!;
    f.title = 'Map to Byrne Auto & Performance, 4354 E Alexander Rd, Las Vegas';
    f.className = 'absolute inset-0 h-full w-full';
    f.style.cssText = 'border:0;filter:invert(.92) hue-rotate(180deg) saturate(.6)';
    f.referrerPolicy = 'no-referrer-when-downgrade';
    box.replaceChildren(f);
  });
</script>
