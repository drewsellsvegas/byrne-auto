---
import Base from '../layouts/Base.astro';
import Pic from '../components/Pic.astro';
import Icon from '../components/Icon.astro';
import Faq from '../components/Faq.astro';
import ServiceCard from '../components/ServiceCard.astro';
import BrandStrip from '../components/BrandStrip.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../data/site';
import { services, serviceBySlug } from '../data/services';
import { href, tel } from '../lib/paths';
import { faqNode } from '../lib/schema';

const featured = ['whipple-supercharger-installs', 'custom-engine-builds', 'performance-mods-tuning', 'ford-5-0-tuning'].map(serviceBySlug);
const strip = [
  ['hemi-throttle-body', 'Red Hemi throttle body on an engine build at Byrne Auto & Performance, Las Vegas'],
  ['corvette-red-engine', 'Red Chevrolet Corvette with a supercharged V8 under the hood, tuned in Las Vegas'],
  ['challenger-yellow-engine', 'Yellow Dodge Challenger with a supercharger and polished intake tube'],
  ['nova-black-lift', 'Black classic Chevy Nova on a lift with the hood up at Byrne Auto & Performance'],
  ['whipple-supercharger', 'Whipple supercharger kit for V8 performance installs in Las Vegas'],
  ['cobra-replica-lift', 'Silver Cobra replica on a lift in the Byrne Auto & Performance bay'],
  ['ram-supercharger', 'Ram truck with a red supercharger installed in Las Vegas'],
  ['holley-ls-intake', 'Red Holley EFI intake on a Chevrolet LS engine build'],
  ['challenger-70-yellow', 'Yellow 1970 Dodge Challenger with the hood open in the shop'],
  ['viper-engine', 'Dodge Viper V10 engine bay with custom headers, Byrne Auto & Performance'],
  ['jeep-rock-crawler', 'Custom Jeep rock crawler on big tires in the Byrne Auto & Performance shop'],
  ['chevelle-blue', 'Blue Chevelle SS parked outside the shop in Las Vegas'],
] as const;
const faq = [
  { q: 'Where is Byrne Auto & Performance located?', a: `We are at ${site.address.full}, in Las Vegas near North Las Vegas. Call ${site.phone.display} for directions or to book.` },
  { q: 'What are your hours?', a: `${site.hours.display}. We are closed Saturday and Sunday.` },
  { q: 'Do you work on regular cars as well as performance builds?', a: 'Yes. We handle major and minor repairs on everyday vehicles, plus performance installs, tuning and engine builds.' },
  { q: 'Which brands are you an authorized dealer for?', a: 'We are an authorized dealer for Dynojet (UTV), FRP, BTR (Brian Tooley Racing), Whipple Superchargers, Rough Country, Texas Speed, JLT intakes and S&B filters.' },
  { q: 'Do you offer fleet maintenance for businesses?', a: 'Yes. We service work trucks, vans and company vehicles. See our fleet maintenance page or call us to talk about your vehicles.' },
  { q: 'How do I get a quote?', a: `Call ${site.phone.display} with your vehicle's year, make and model and what you need. Not every part or service is listed on this site, so ask.` },
];
---
<Base
  title="Byrne Auto & Performance | Las Vegas Auto Repair & Tuning"
  description="Las Vegas auto repair and performance shop: transmission rebuilds, engine builds, Whipple installs, tuning and fleet maintenance. (702) 742-0873."
  path="/"
  schema={[faqNode(faq)]}
>
  <!-- HERO -->
  <section class="relative isolate flex min-h-[100svh] flex-col overflow-hidden bg-ink sm:flex-row sm:items-center">
    <div class="relative mt-[4.25rem] aspect-[2000/1042] w-full shrink-0 sm:absolute sm:inset-x-0 sm:top-0 sm:-z-20 sm:mt-0">
      <div class="absolute inset-0 hero-zoom"><Pic name="charger-orange" alt="Orange Dodge Charger Hellcat strapped down on the dyno at Byrne Auto & Performance in Las Vegas, NV" priority sizes="100vw" widths={[800, 1280, 1800, 2200]} position="center" /></div>
      <div class="absolute inset-0 bg-gradient-to-t from-ink via-transparent to-transparent"></div>
    </div>
    <div class="absolute inset-0 -z-10 hidden bg-gradient-to-r from-ink/92 via-ink/45 to-transparent sm:block"></div>
        <div class="wrap relative pb-14 pt-4 sm:py-32">
      <p class="eyebrow" data-reveal>Las Vegas · North Las Vegas · 89115</p>
      <h1 class="mt-5 max-w-4xl" data-reveal style="--d:80ms">Built for power.<br /><span class="text-red-hot">Trusted for repairs.</span></h1>
      <p class="lead mt-6 sm:max-w-xl" data-reveal style="--d:160ms">Byrne Auto &amp; Performance is the Las Vegas shop for transmission rebuilds, engine builds, supercharger installs and tuning, plus everyday maintenance and repair done right the first time.</p>
      <div class="mt-9 flex flex-wrap gap-3" data-reveal style="--d:240ms">
        <a href={tel} class="btn btn-red" data-call><Icon name="phone" size={20} /> Call {site.phone.display}</a>
      </div>
      <ul class="mt-12 grid max-w-3xl gap-x-8 gap-y-4 border-t border-white/15 pt-6 text-sm sm:grid-cols-3" data-reveal style="--d:320ms">
        <li><span class="block font-display text-2xl font-extrabold uppercase text-white">Authorized</span><span class="text-fog">Dynojet, Whipple, BTR &amp; more</span></li>
        <li><span class="block font-display text-2xl font-extrabold uppercase text-white">Mon–Fri 8–5</span><span class="text-fog">4354 E Alexander Rd</span></li>
        <li><span class="block font-display text-2xl font-extrabold uppercase text-white">Major &amp; minor</span><span class="text-fog">Repairs, builds and tuning</span></li>
      </ul>
    </div>
  </section>

  <BrandStrip />

  <!-- FEATURED -->
  <section class="section">
    <div class="wrap">
      <div class="max-w-3xl" data-reveal>
        <p class="eyebrow">What we do best</p>
        <h2 class="mt-4">Serious work for serious builds</h2>
        <p class="lead mt-5">Superchargers, engine builds, tuning and complete power packages for the people who want more from their vehicle.</p>
      </div>
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {featured.map((s, i) => <ServiceCard s={s} delay={i * 80} />)}
      </div>
    </div>
  </section>

  <!-- TRANSMISSION BAND -->
  <section class="border-y border-line bg-coal">
    <div class="wrap grid items-center gap-10 py-16 lg:grid-cols-2 lg:gap-16 lg:py-24">
      <div class="relative aspect-[4/3] overflow-hidden rounded-md" data-reveal>
        <Pic name="transmission" alt="Rebuilt automatic transmission on a bench at Byrne Auto & Performance, Las Vegas transmission shop" sizes="(min-width:1024px) 600px, 92vw" widths={[500, 800, 1200]} />
        <div class="absolute bottom-0 left-0 h-1.5 w-1/3 bg-red"></div>
      </div>
      <div data-reveal style="--d:120ms">
        <p class="eyebrow">Our differentiator</p>
        <h2 class="mt-4">Transmission rebuilding</h2>
        <p class="lead mt-5">Rebuilding transmissions is what sets us apart from other mechanics. Whether it's a daily driver, a work truck or a high-horsepower build, we take it apart, replace what's worn and put it back together to handle the job you actually give it.</p>
        <ul class="tick mt-6 grid gap-2.5">
          <li>Full teardown, inspection and rebuild</li>
          <li>Upgraded parts for added power</li>
          <li>Matched to supercharger and engine builds</li>
        </ul>
        <a href={href('/services/transmission-rebuilding')} class="btn btn-red mt-8">Transmission rebuilds <Icon name="arrow-right" size={20} /></a>
      </div>
    </div>
  </section>

  <!-- PHOTO STRIP -->
  <section aria-label="Recent builds and shop photos" class="marquee overflow-hidden py-10" style="--t:70s">
    <div class="marquee-track gap-4 pr-4">
      {[0, 1].map((n) => (
        <ul class="flex shrink-0 gap-4" aria-hidden={n === 1 ? 'true' : undefined}>
          {strip.map(([name, alt]) => (
            <li class="h-52 w-72 shrink-0 overflow-hidden rounded-md sm:h-64 sm:w-96"><Pic name={name} alt={n === 1 ? '' : alt} sizes="384px" widths={[400, 700]} /></li>
          ))}
        </ul>
      ))}
    </div>
  </section>

  <!-- ALL SERVICES -->
  <section class="section pt-6">
    <div class="wrap">
      <div class="flex flex-col justify-between gap-6 lg:flex-row lg:items-end" data-reveal>
        <div><p class="eyebrow">Every service</p><h2 class="mt-4">One shop for it all</h2></div>
        <a href={href('/services')} class="btn btn-ghost self-start">Browse services <Icon name="arrow-right" size={18} /></a>
      </div>
      <ul class="mt-10 grid gap-px overflow-hidden border border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
        {services.map((s) => (
          <li class="bg-ink"><a href={href(`/services/${s.slug}`)} class="group flex items-center gap-4 p-5 no-underline transition-colors hover:bg-panel">
            <span class="grid h-11 w-11 shrink-0 place-items-center border border-line text-red-hot transition-colors group-hover:border-red group-hover:bg-red group-hover:text-white"><Icon name={s.icon} size={20} /></span>
            <span class="font-display text-xl font-bold uppercase tracking-wide">{s.name}</span>
            <Icon name="arrow-right" size={18} class="ml-auto shrink-0 text-fog transition-transform group-hover:translate-x-1 group-hover:text-white" />
          </a></li>
        ))}
        {services.length % 2 === 1 && <li class="bg-ink max-sm:hidden lg:hidden" aria-hidden="true"></li>}
        {services.length % 3 !== 0 && <li class="bg-ink max-lg:hidden" aria-hidden="true" style={`grid-column: span ${3 - (services.length % 3)}`}></li>}
      </ul>
    </div>
  </section>

  <!-- WHY -->
  <section class="section border-y border-line bg-coal">
    <div class="wrap">
      <div class="max-w-3xl" data-reveal><p class="eyebrow">Why Byrne</p><h2 class="mt-4">Prevent problems before they happen</h2></div>
      <div class="mt-12 grid gap-px bg-line sm:grid-cols-2 lg:grid-cols-4">
        {[
          ['01', 'Latest diagnostics', 'Current diagnostic technology finds the real cause, so you pay to fix the right thing.'],
          ['02', 'Top-quality parts', 'We use only the best parts and tuning solutions from brands we trust.'],
          ['03', 'Authorized dealer', 'Parts and tuning straight from the brands that build them, backed by people who install them every day.'],
          ['04', 'Major to minor', 'Oil changes to full engine builds, one shop with the skills to do it right.'],
        ].map(([n, t, d], i) => (
          <div class="bg-coal p-7" data-reveal style={`--d:${i * 80}ms`}>
            <span class="font-display text-5xl font-extrabold text-red">{n}</span>
            <h3 class="mt-3">{t}</h3>
            <p class="mt-2 text-sm text-fog">{d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FLEET + OFFROAD -->
  <section class="section">
    <div class="wrap grid gap-6 lg:grid-cols-2">
      <a href={href('/services/fleet-maintenance')} class="card group relative isolate flex min-h-[26rem] flex-col justify-end p-8 no-underline" data-reveal>
        <div class="absolute inset-0 -z-10"><Pic name="fleet-row" alt="Row of Dodge Charger, Challenger and Ram fleet vehicles serviced by Byrne Auto & Performance in Las Vegas" sizes="(min-width:1024px) 600px, 92vw" widths={[600, 1000, 1500]} position="30% center" /></div>
        <div class="absolute inset-0 -z-10 bg-gradient-to-t from-ink via-ink/70 to-ink/20"></div>
        <p class="eyebrow">For businesses</p>
        <h2 class="mt-3 text-4xl sm:text-5xl">Fleet maintenance</h2>
        <p class="mt-3 max-w-md text-[#d4d4d8]">Keep work trucks, vans and company vehicles earning with scheduled service and fast repairs.</p>
        <span class="mt-5 inline-flex items-center gap-2 font-display font-bold uppercase tracking-[0.15em] text-red-hot">Learn more <Icon name="arrow-right" size={18} /></span>
      </a>
      <a href={href('/services/utv-performance')} class="card group relative isolate flex min-h-[26rem] flex-col justify-end p-8 no-underline" data-reveal style="--d:100ms">
        <div class="absolute inset-0 -z-10"><Pic name="utv-dynojet" alt="UTV kicking up desert dust with Dynojet performance parts, available through Byrne Auto & Performance in Las Vegas" sizes="(min-width:1024px) 600px, 92vw" widths={[600, 1000, 1500]} /></div>
        <div class="absolute inset-0 -z-10 bg-gradient-to-t from-ink via-ink/60 to-ink/10"></div>
        <p class="eyebrow">Off-road</p>
        <h2 class="mt-3 text-4xl sm:text-5xl">UTV performance</h2>
        <p class="mt-3 max-w-md text-[#d4d4d8]">Authorized Dynojet dealer and installer for power packages and fuel management.</p>
        <span class="mt-5 inline-flex items-center gap-2 font-display font-bold uppercase tracking-[0.15em] text-red-hot">Learn more <Icon name="arrow-right" size={18} /></span>
      </a>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section border-t border-line">
    <div class="wrap grid gap-12 lg:grid-cols-[1fr_1.6fr]">
      <div data-reveal><p class="eyebrow">Questions</p><h2 class="mt-4">Quick answers</h2><p class="lead mt-5">Don't see yours? Call {site.phone.display}. We're happy to talk it through.</p></div>
      <div data-reveal style="--d:100ms"><Faq items={faq} /></div>
    </div>
  </section>

  <!-- LOCATION -->
  <section class="border-t border-line bg-coal">
    <div class="wrap grid items-center gap-10 py-16 lg:grid-cols-2 lg:gap-16 lg:py-24">
      <div data-reveal>
        <p class="eyebrow">Visit the shop</p>
        <h2 class="mt-4">4354 E Alexander Rd</h2>
        <p class="lead mt-4">Las Vegas, NV 89115<br />{site.hours.display} · {site.hours.detail}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={`https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(site.mapsQuery)}`} class="btn btn-red"><Icon name="map-pin" size={20} /> Get directions</a>
          <a href={href('/contact')} class="btn btn-ghost">Contact</a>
        </div>
      </div>
      <div class="relative aspect-[4/3] overflow-hidden rounded-md border border-line bg-coal" data-reveal style="--d:100ms">
        <iframe title="Map to Byrne Auto & Performance, 4354 E Alexander Rd, Las Vegas, NV 89115" src={site.mapEmbed} class="absolute inset-0 h-full w-full" loading="lazy" referrerpolicy="strict-origin-when-cross-origin" style="border:0;filter:invert(.92) hue-rotate(180deg) saturate(.6)"></iframe>
      </div>
    </div>
  </section>

  <CtaBand title="Let's talk about your vehicle" />
</Base>
