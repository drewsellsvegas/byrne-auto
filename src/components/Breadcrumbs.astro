---
import { href } from '../lib/paths';
interface Props { trail: { name: string; path?: string }[] }
const { trail } = Astro.props;
---
<nav aria-label="Breadcrumb" class="text-sm text-fog">
  <ol class="flex flex-wrap items-center gap-2">
    <li><a href={href('/')} class="hover:text-white">Home</a></li>
    {trail.map((c, i) => (
      <li class="flex items-center gap-2"><span aria-hidden="true">/</span>{c.path && i < trail.length - 1 ? <a href={href(c.path)} class="hover:text-white">{c.name}</a> : <span class="text-white" aria-current="page">{c.name}</span>}</li>
    ))}
  </ol>
</nav>
