---
import Pic from './Pic.astro';
import Icon from './Icon.astro';
import { href } from '../lib/paths';
import type { Service } from '../data/services';
interface Props { s: Service; delay?: number; priority?: boolean }
const { s, delay = 0 } = Astro.props;
---
<a href={href(`/services/${s.slug}`)} class="card group flex flex-col no-underline" data-reveal style={`--d:${delay}ms`}>
  <div class="relative aspect-[16/10] overflow-hidden bg-coal">
    <Pic name={s.photo} alt={s.photoAlt} sizes="(min-width:1024px) 380px, (min-width:640px) 45vw, 92vw" widths={[400, 700, 1000]} />
    <div class="absolute inset-0 bg-gradient-to-t from-ink/80 via-transparent to-transparent"></div>
    <span class="absolute bottom-3 left-3 grid h-10 w-10 place-items-center bg-red text-white"><Icon name={s.icon} size={20} /></span>
  </div>
  <div class="flex flex-1 flex-col gap-2 p-5">
    <h3>{s.name}</h3>
    <p class="text-sm text-fog">{s.summary}</p>
    <span class="mt-auto inline-flex items-center gap-2 pt-3 font-display text-sm font-bold uppercase tracking-[0.15em] text-red-hot">Details <Icon name="arrow-right" size={16} class="transition-transform group-hover:translate-x-1" /></span>
  </div>
</a>
