---
import Icon from './Icon.astro';
import { site } from '../data/site';
import { tel } from '../lib/paths';
interface Props { title?: string; text?: string }
const { title = 'Ready when you are', text = "Tell us what you drive and what you want done. We'll tell you straight what it takes." } = Astro.props;
---
<section class="relative overflow-hidden bg-red">
  <div class="absolute inset-y-0 right-0 hidden w-1/3 bg-black/15 lg:block" style="clip-path:polygon(30% 0,100% 0,100% 100%,0 100%)"></div>
  <div class="wrap relative flex flex-col items-start gap-6 py-14 lg:flex-row lg:items-center lg:justify-between">
    <div data-reveal>
      <h2 class="text-white">{title}</h2>
      <p class="mt-3 max-w-xl text-white/90">{text}</p>
      <p class="mt-2 text-sm text-white/80">{site.hours.display} · {site.hours.detail}</p>
    </div>
    <div class="flex flex-wrap gap-3" data-reveal style="--d:120ms">
      <a href={tel} class="btn bg-white text-ink hover:bg-ink hover:text-white" data-call><Icon name="phone" size={20} /> Call {site.phone.display}</a>
    </div>
  </div>
</section>
