---
import { Image } from 'astro:assets';
import mark from '../assets/brand/mark.png';
import Icon from './Icon.astro';
import { site } from '../data/site';
import { services, groups, type Group } from '../data/services';
import { href, tel } from '../lib/paths';
interface Props { path: string }
const { path } = Astro.props;
const here = (p: string) => path === p || path.startsWith(p + '/');
const links = [
  { name: 'Fleet', path: '/services/fleet-maintenance' },
  { name: 'Gallery', path: '/gallery' },
  { name: 'About', path: '/about' },
  { name: 'Contact', path: '/contact' },
];
const order: Group[] = ['repair', 'performance', 'specialty'];
---
<header id="site-header" class="fixed inset-x-0 top-0 z-50 border-b border-transparent transition-colors duration-300 data-[solid=true]:border-line data-[solid=true]:bg-ink/92 data-[solid=true]:backdrop-blur-md" data-solid="false">
  <div class="wrap flex h-[4.25rem] items-center justify-between gap-4 lg:h-20">
    <a href={href('/')} class="flex items-center gap-3 no-underline">
      <Image src={mark} alt="" width={44} height={Math.round(44 * mark.height / mark.width)} class="h-11 w-auto" loading="eager" />
      <span class="leading-none">
        <span class="block font-display text-2xl font-extrabold uppercase tracking-[0.06em] text-white">Byrne</span>
        <span class="block font-display text-[0.72rem] font-bold uppercase tracking-[0.3em] text-red-hot">Auto &amp; Performance</span>
      </span>
    </a>

    <nav aria-label="Primary" class="hidden items-center gap-1 lg:flex">
      <div class="group relative">
        <a href={href('/services')} class:list={['flex items-center gap-1 px-4 py-6 font-display text-lg font-bold uppercase tracking-[0.1em] no-underline hover:text-red-hot', here('/services') && !path.includes('fleet') && 'text-red-hot']}>Services <Icon name="chevron-down" size={16} /></a>
        <div class="invisible absolute left-1/2 top-full w-[56rem] -translate-x-1/2 translate-y-2 border border-line bg-coal p-7 opacity-0 shadow-2xl transition duration-200 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100">
          <div class="grid grid-cols-3 gap-8">
            {order.map((g) => (
              <div>
                <p class="eyebrow mb-3">{groups[g].label}</p>
                <ul class="space-y-1.5">
                  {services.filter((s) => s.group === g).map((s) => (
                    <li><a href={href(`/services/${s.slug}`)} class="block py-0.5 text-[0.95rem] text-[#d4d4d8] no-underline hover:text-white">{s.name}</a></li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </div>
      {links.map((l) => (
        <a href={href(l.path)} class:list={['px-4 py-6 font-display text-lg font-bold uppercase tracking-[0.1em] no-underline hover:text-red-hot', here(l.path) && 'text-red-hot']}>{l.name}</a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <a href={tel} class="btn btn-red hidden sm:inline-flex !py-2.5" data-call><Icon name="phone" size={18} /> {site.phone.display}</a>
      <button id="menu-btn" type="button" class="grid h-11 w-11 place-items-center rounded border border-line text-white lg:hidden" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu"><Icon name="menu" size={24} /></button>
    </div>
  </div>

  <div id="mobile-menu" hidden class="max-h-[calc(100dvh-4.25rem)] overflow-y-auto border-t border-line bg-ink lg:hidden">
    <nav aria-label="Mobile" class="wrap py-4">
      <a href={href('/services')} class="block py-3 font-display text-3xl font-extrabold uppercase no-underline">All Services</a>
      {order.map((g) => (
        <details class="border-t border-line py-1">
          <summary class="flex cursor-pointer list-none items-center justify-between py-3 font-display text-xl font-bold uppercase tracking-wide text-red-hot [&::-webkit-details-marker]:hidden">{groups[g].label} <Icon name="chevron-down" size={18} /></summary>
          <ul class="pb-3 pl-1">
            {services.filter((s) => s.group === g).map((s) => (
              <li><a href={href(`/services/${s.slug}`)} class="block py-2 text-[#d4d4d8] no-underline">{s.name}</a></li>
            ))}
          </ul>
        </details>
      ))}
      {links.map((l) => (
        <a href={href(l.path)} class="block border-t border-line py-3 font-display text-3xl font-extrabold uppercase no-underline">{l.name}</a>
      ))}
    </nav>
  </div>
</header>
