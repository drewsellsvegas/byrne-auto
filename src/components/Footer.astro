---
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo.png';
import Icon from './Icon.astro';
import { site } from '../data/site';
import { services } from '../data/services';
import { href, tel } from '../lib/paths';
const col = (g: string) => services.filter((s) => s.group === g);
---
<footer class="border-t border-line bg-coal">
  <div class="stripe h-1.5 opacity-80"></div>
  <div class="wrap grid gap-12 py-16 lg:grid-cols-[1.2fr_1fr_1fr_1fr]">
    <div>
      <Image src={logo} alt="Byrne Auto & Performance logo, Las Vegas auto repair and performance shop" width={180} height={Math.round(180 * logo.height / logo.width)} class="h-auto w-44" loading="lazy" />
      <address class="mt-6 space-y-3 not-italic text-[#d4d4d8]">
        <p class="flex gap-3"><Icon name="map-pin" class="mt-1 shrink-0 text-red-hot" /><a href={`https://www.google.com/maps?q=${encodeURIComponent(site.mapsQuery)}`} class="hover:text-white">{site.address.street}<br />{site.address.city}, {site.address.region} {site.address.zip}</a></p>
        <p class="flex gap-3"><Icon name="phone" class="mt-1 shrink-0 text-red-hot" /><a href={tel} class="hover:text-white" data-call>{site.phone.display}</a></p>
        <p class="flex gap-3"><Icon name="mail" class="mt-1 shrink-0 text-red-hot" /><a href={`mailto:${site.email}`} class="break-all hover:text-white">{site.email}</a></p>
        <p class="flex gap-3"><Icon name="clock" class="mt-1 shrink-0 text-red-hot" /><span>{site.hours.display}<br /><span class="text-fog">{site.hours.detail}</span></span></p>
      </address>
      <a href={site.facebook} rel="noopener" target="_blank" class="mt-5 inline-flex items-center gap-2 text-fog hover:text-white" aria-label="Byrne Auto & Performance on Facebook">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.5 22v-8.2h2.8l.5-3.3h-3.3V8.4c0-.9.4-1.7 1.8-1.7h1.6V3.8c-.3 0-1.3-.2-2.4-.2-2.5 0-4.1 1.5-4.1 4.2v2.7H7.6v3.3h2.8V22h3.1z" /></svg> Facebook
      </a>
    </div>
    <div>
      <p class="eyebrow mb-4">Repair &amp; Maintenance</p>
      <ul class="space-y-2 text-[0.95rem] text-[#d4d4d8]">{col('repair').map((s) => <li><a href={href(`/services/${s.slug}`)} class="hover:text-white">{s.name}</a></li>)}</ul>
    </div>
    <div>
      <p class="eyebrow mb-4">Performance</p>
      <ul class="space-y-2 text-[0.95rem] text-[#d4d4d8]">{col('performance').map((s) => <li><a href={href(`/services/${s.slug}`)} class="hover:text-white">{s.name}</a></li>)}</ul>
    </div>
    <div>
      <p class="eyebrow mb-4">Fleet &amp; Off-Road</p>
      <ul class="space-y-2 text-[0.95rem] text-[#d4d4d8]">{col('specialty').map((s) => <li><a href={href(`/services/${s.slug}`)} class="hover:text-white">{s.name}</a></li>)}</ul>
      <p class="eyebrow mb-4 mt-8">Company</p>
      <ul class="space-y-2 text-[0.95rem] text-[#d4d4d8]">
        <li><a href={href('/services')} class="hover:text-white">All services</a></li>
        <li><a href={href('/gallery')} class="hover:text-white">Gallery</a></li>
        <li><a href={href('/about')} class="hover:text-white">About</a></li>
        <li><a href={href('/contact')} class="hover:text-white">Contact</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-line">
    <div class="wrap flex flex-col items-center gap-3 py-6 text-center text-sm text-fog">
      <p>© {new Date().getFullYear()} {site.name}. Serving Las Vegas &amp; North Las Vegas, NV.</p>
      <a href="https://evoxed.com" rel="noopener" class="no-underline">Website by <span class="font-display text-lg font-extrabold uppercase tracking-[0.12em] text-white">Evoxed</span></a>
    </div>
  </div>
</footer>
