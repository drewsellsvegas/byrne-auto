---
import Icon from './Icon.astro';
import { site } from '../data/site';
import { tel } from '../lib/paths';
---
<div class="fixed inset-x-0 bottom-0 z-40 border-t border-line bg-red pb-[env(safe-area-inset-bottom)] lg:hidden">
  <a href={tel} data-call class="flex h-[4.25rem] items-center justify-center gap-3 font-display text-2xl font-extrabold uppercase tracking-[0.1em] text-white no-underline"><Icon name="phone" size={24} /> Call {site.phone.display}</a>
</div>
