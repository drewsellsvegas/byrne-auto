---
import Icon from './Icon.astro';
interface Props { items: { q: string; a: string }[] }
const { items } = Astro.props;
---
<div class="divide-y divide-line border-y border-line">
  {items.map((f) => (
    <details class="group py-5">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-6 font-display text-xl font-bold uppercase tracking-wide marker:hidden sm:text-2xl [&::-webkit-details-marker]:hidden">
        {f.q}
        <Icon name="plus" size={22} class="shrink-0 text-red transition-transform duration-300 group-open:rotate-45" />
      </summary>
      <p class="mt-3 max-w-3xl text-[#d4d4d8]">{f.a}</p>
    </details>
  ))}
</div>
