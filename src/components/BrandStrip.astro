---
import { Image } from 'astro:assets';
import dynojet from '../assets/brands/dynojet.png';
import frp from '../assets/brands/frp.png';
import btr from '../assets/brands/btr.png';
import whipple from '../assets/brands/whipple.png';
import roughCountry from '../assets/brands/rough-country.png';
import texas from '../assets/brands/texas-speed.png';
import jlt from '../assets/brands/jlt.png';
import sb from '../assets/brands/sb.png';

// Logos sit on a light or black tile, whichever suits the file supplied.
const brands = [
  { name: 'Dynojet', src: dynojet, tile: 'dark', h: 44 },
  { name: 'FRP Tuning', src: frp, tile: 'dark', h: 24 },
  { name: 'BTR Brian Tooley Racing', src: btr, tile: 'dark', h: 76 },
  { name: 'Whipple Superchargers', src: whipple, tile: 'dark', h: 38 },
  { name: 'Rough Country', src: roughCountry, tile: 'light', h: 28 },
  { name: 'Texas Speed & Performance', src: texas, tile: 'dark', h: 54 },
  { name: 'JLT Performance', src: jlt, tile: 'light', h: 46 },
  { name: 'S&B Filters', src: sb, tile: 'dark', h: 56 },
];
---
<section aria-label="Authorized dealer and installer brands" class="border-y border-line bg-coal py-10">
  <div class="wrap mb-7 text-center sm:text-left">
    <p class="eyebrow">Authorized dealer &amp; installer</p>
  </div>
  <div class="marquee overflow-hidden [mask-image:linear-gradient(90deg,transparent,#000_8%,#000_92%,transparent)]" style="--t:38s">
    <div class="marquee-track">
      {[0, 1].map((n) => (
        <ul class="flex shrink-0 gap-4 pr-4" aria-hidden={n === 1 ? 'true' : undefined}>
          {brands.map((b) => (
            <li class:list={['grid h-24 w-56 shrink-0 place-items-center rounded-md border', b.tile === 'light' ? 'border-white/20 bg-[#f4f4f5]' : 'border-line bg-black']} title={b.name}>
              <Image src={b.src} alt={n === 0 ? `${b.name} logo, authorized dealer at Byrne Auto & Performance in Las Vegas` : ''} height={b.h} width={Math.round((b.h * b.src.width) / b.src.height)} style={`max-height:${b.h}px;max-width:200px;width:auto;height:auto`} loading="lazy" />
            </li>
          ))}
        </ul>
      ))}
    </div>
  </div>
</section>
